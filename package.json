{
  "name": "web-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Console signaling service — a thin WebRTC room relay (SDP/ICE) keyed by room code.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "serve:app": "STATIC_DIR=.. PORT=8000 node server.js",
    "build:static": "node scripts/build-static.mjs",
    "serve:dist": "STATIC_DIR=./public PORT=8000 node server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
